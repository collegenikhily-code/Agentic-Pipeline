# M1 Environment Variables
#
# Copy this file to .env and adjust for your environment.
# NO mandatory API credentials required for M1.
#
# To run unit tests: just having this file (or defaults) is sufficient.
# To run integration tests: start Docker PostgreSQL with appropriate credentials.

# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=seo_aeo_geo
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# Environment
ENVIRONMENT=development

# Optional: pSEO Engine LiteLLM generation (M2+)
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# OPENAI_API_KEY=

# Optional: SEO data collection (M2+)
# DATAFORSEO_LOGIN=
# DATAFORSEO_PASSWORD
# SERPAPI_API_KEY
# KEYWORDS_EVERYWHERE_API_KEY
# MOZ_ACCESS_ID
# MOZ_SECRET_KEY

# Dify Knowledge Base (for competitor intelligence retrieval)
# DIFY_API_KEY=
# DIFY_BASE_URL=https://api.dify.ai
# DIFY_DATASET_ID=

# SE Ranking API (for live keyword discovery)
# SE_RANKING_API_KEY=

# Langfuse Observability (for LLM tracing)
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com

# LetterTrace Observability (for pipeline monitoring)
# LETTERTRACE_API_KEY=
# LETTERTRACE_BASE_URL=https://api.lettertrace.ai
# LETTERTRACE_PROJECT_ID=

# HyperText Template Selection (for dynamic template selection)
# HYPERTEXT_API_KEY=
# HYPERTEXT_BASE_URL=https://api.hypertext.ai

# OpenRouter (for LLM generation via LiteLLM)
# OPENROUTER_API_KEY=