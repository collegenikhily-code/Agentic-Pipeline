# M1: Development environment for seo-aeo-geo-pipeline
#
# Required to run:
#   make install    - install package and dependencies
#   make test       - run unit tests (no PostgreSQL required)
#   make integration  - run integration tests (Docker PostgreSQL required)
#   make lint       - run linting

# Gitignored files
.env
__pycache__/
*.pyc
.pyvenv/
/venv/
/env/
.mcp-auth/
.hypothesis/
.coverage

