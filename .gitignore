output/e2e_proof/*/
!output/e2e_proof/20261006-182128/
!output/e2e_proof/20261005-132103/
output/competitor_proof/*/
output/concurrency_proof/*/
output/intelligence_proof/*/
runs/*/
!runs/20260917-125039/
!runs/20260917-134509/
!runs/20260917-133825/
*.log
traces.jsonl

